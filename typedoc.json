{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src/index.tsx"],
  "out": "./docs/api-reference",
  "json": "./build/typedoc/api.json",
  "tsconfig": "./tsconfig.build.json",
  "readme": "none",
  "disableGit": true,
  "sourceLinkTemplate": "https://github.com/stripe/stripe-terminal-react-native/blob/main/{path}#L{line}",
  "excludeInternal": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "intentionallyNotExported": ["EventEmitter"],
  "treatWarningsAsErrors": true
}
